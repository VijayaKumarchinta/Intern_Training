DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/line30

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=live_dashboard
MQTT_KEEPALIVE_SECONDS=60

MQTT_TOPIC_TELEMETRY=line30/telemetry/{machine_code}
MQTT_TOPIC_STATE=line30/state/{machine_code}
MQTT_TOPIC_COMMAND=line30/command/{machine_code}

REPLAY_INTERVAL_SECONDS=1.0
